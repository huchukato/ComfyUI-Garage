# ComfyUI-Garage RunPod Worker (CUDA 12.8) — WAN 2.2 edition
# Based on comfyui-base:cu128 (our custom base with ComfyUI v0.34.2, TensorRT,
# Manager with use_uv=False, dynamic venv naming, no uv).
# Adds: custom nodes, llama-cpp-python, sageattention, essential models, WAN2.2 workflows
# Compatible with RTX 4090 (Ada) and RTX 5090 (Blackwell)

FROM huchukato/comfyui-base:cu128

# ──────────────────────────────────────────────────────────────────────────────
# Custom nodes — ALL repos cloned once (cached by Docker)
# Use --no-cache to force re-clone when nodes need updating.
# ──────────────────────────────────────────────────────────────────────────────
ARG CACHEBUST=1

ENV GIT_TERMINAL_PROMPT=0
RUN dl_gh() { \
    local user="$1" repo="$2" branch="${3:-main}" dir="$4"; \
    echo "Downloading $user/$repo ($branch) -> $dir"; \
    curl -fsSL "https://codeload.github.com/$user/$repo/tar.gz/refs/heads/$branch" -o "/tmp/$dir.tgz" && \
    mkdir -p "/opt/comfyui-baked/custom_nodes/$dir" && \
    tar -xzf "/tmp/$dir.tgz" -C "/opt/comfyui-baked/custom_nodes/$dir" --strip-components=1 && \
    rm -f "/tmp/$dir.tgz"; \
  } && \
    cd /opt/comfyui-baked/custom_nodes && \
    dl_gh city96 ComfyUI-GGUF main ComfyUI-GGUF && \
    dl_gh Koishi-Star Euler-Smea-Dyn-Sampler main Euler-Smea-Dyn-Sampler && \
    dl_gh ltdrdata was-node-suite-comfyui main was-node-suite-comfyui && \
    dl_gh Kosinkadink ComfyUI-VideoHelperSuite main ComfyUI-VideoHelperSuite && \
    dl_gh rgthree rgthree-comfy main rgthree-comfy && \
    dl_gh yolain ComfyUI-Easy-Use main ComfyUI-Easy-Use && \
    dl_gh Fannovel16 ComfyUI-Frame-Interpolation main ComfyUI-Frame-Interpolation && \
    dl_gh Smirnov75 ComfyUI-mxToolkit main ComfyUI-mxToolkit && \
    dl_gh princepainter ComfyUI-PainterI2V main ComfyUI-PainterI2V && \
    dl_gh princepainter ComfyUI-PainterLongVideo main ComfyUI-PainterLongVideo && \
    dl_gh ashtar1984 comfyui-find-perfect-resolution main comfyui-find-perfect-resolution && \
    dl_gh kijai ComfyUI-MMAudio main ComfyUI-MMAudio && \
    dl_gh GACLove ComfyUI-VFI main ComfyUI-VFI && \
    dl_gh stduhpf ComfyUI-WanMoeKSampler master ComfyUI-WanMoeKSampler && \
    dl_gh melMass comfy_mtb main comfy_mtb && \
    dl_gh huchukato ComfyUI-QwenVL-Mod main ComfyUI-QwenVL-Mod && \
    dl_gh huchukato ComfyUI-RIFE-TensorRT-Auto master ComfyUI-RIFE-TensorRT-Auto && \
    dl_gh huchukato ComfyUI-Upscaler-TensorRT-Auto master ComfyUI-Upscaler-TensorRT-Auto && \
    dl_gh huchukato ComfyUI-HuggingFace main ComfyUI-HuggingFace && \
    dl_gh huchukato comfy-tagcomplete main comfy-tagcomplete && \
    dl_gh huchukato ComfyUI-Selectors main ComfyUI-Selectors && \
    dl_gh ltdrdata ComfyUI-Impact-Pack Main ComfyUI-Impact-Pack && \
    dl_gh ltdrdata ComfyUI-Impact-Subpack main ComfyUI-Impact-Subpack

# ──────────────────────────────────────────────────────────────────────────────
# Install requirements (single layer, cached)
# ──────────────────────────────────────────────────────────────────────────────
RUN bash -c 'cd /opt/comfyui-baked/custom_nodes && for node_dir in */; do \
        if [ -f "$node_dir/requirements.txt" ]; then \
            echo "Installing requirements for $node_dir..." && \
            pip install --no-cache-dir -r "$node_dir/requirements.txt" || echo "Failed to install requirements for $node_dir"; \
        fi; \
    done' && \
    pip cache purge

# ──────────────────────────────────────────────────────────────────────────────
# Model directories
# ──────────────────────────────────────────────────────────────────────────────
RUN mkdir -p /opt/comfyui-baked/models/vae && \
    mkdir -p /opt/comfyui-baked/models/upscale_models && \
    mkdir -p /opt/comfyui-baked/models/text_encoders && \
    mkdir -p /opt/comfyui-baked/models/diffusion_models && \
    mkdir -p /opt/comfyui-baked/models/ultralytics/bbox && \
    mkdir -p /opt/comfyui-baked/models/sams

# ──────────────────────────────────────────────────────────────────────────────
# Pre-baked essential models (~1GB, copied to /workspace on first boot by start.sh)
# Text encoder (~5GB) moved to boot-time download to reduce image size.
# ──────────────────────────────────────────────────────────────────────────────
RUN wget -q "https://huggingface.co/huchukato/pimp-my-wan/resolve/main/vae/wan_2.1_vae.safetensors" \
        -O /opt/comfyui-baked/models/vae/wan_2.1_vae.safetensors && \
    wget -q "https://huggingface.co/huchukato/favs/resolve/main/VAE/sdxl.vae.safetensors" \
        -O /opt/comfyui-baked/models/vae/sdxl_vae.safetensors && \
    wget -q "https://huggingface.co/huchukato/favs/resolve/main/ESRGAN/2xLexicaRRDBNet.pth" \
        -O /opt/comfyui-baked/models/upscale_models/2xLexicaRRDBNet.pth && \
    wget -q "https://huggingface.co/huchukato/favs/resolve/main/ESRGAN/2xLexicaRRDBNet_Sharp.pth" \
        -O /opt/comfyui-baked/models/upscale_models/2xLexicaRRDBNet_Sharp.pth && \
    wget -q --tries=5 --timeout=60 --retry-connrefused \
        "https://huggingface.co/Bingsu/adetailer/resolve/main/face_yolov8m.pt" \
        -O /opt/comfyui-baked/models/ultralytics/bbox/face_yolov8m.pt && \
    wget -q --tries=5 --timeout=60 --retry-connrefused \
        "https://dl.fbaipublicfiles.com/segment_anything/sam_vit_b_01ec64.pth" \
        -O /opt/comfyui-baked/models/sams/sam_vit_b_01ec64.pth

# ──────────────────────────────────────────────────────────────────────────────
# Pre-baked WAN 2.2 workflows
# ──────────────────────────────────────────────────────────────────────────────
RUN mkdir -p /opt/comfyui-baked/user/default/workflows/{pony,wan22/fp8,wan22/gguf,utils} && \
    cd /opt/comfyui-baked/user/default/workflows && \
    for url in \
        "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/utils/2in1-LoRaStack-Merge.json" \
        "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/utils/RIFE-TensorRT-60FPS.json" \
        "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/pony/PimpMyPony-TagComplete-Wildcards.json" \
        "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/pony/PimpMyPony-TagComplete-Wildcards-HiresFix.json" \
        "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/pony/PimpMyPony-TagComplete-FaceDet.json" \
        "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/wan22/fp8/WAN2.2-I2V-AutoPrompt-Story.json" \
        "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/wan22/fp8/WAN2.2-T2V-I2V-AutoPrompt-Story.json" \
        "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/wan22/fp8/WAN2.2-I2V-SVI-AutoPrompt-Story.json" \
        "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/wan22/fp8/WAN2.2-I2V-AutoPrompt.json" \
        "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/wan22/gguf/WAN2.2-I2V-AutoPrompt-GGUF.json" \
        "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/wan22/fp8/WAN2.2-T2V-AutoPrompt.json" \
        "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/wan22/gguf/WAN2.2-T2V-AutoPrompt-GGUF.json" \
        "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/wan22/fp8/WAN2.2-I2V-SVI-AutoPrompt.json" \
        "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/wan22/gguf/WAN2.2-I2V-SVI-AutoPrompt-GGUF.json" \
        "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/wan22/fp8/WAN2.2-I2V-Full-AutoPrompt-MMAudio.json" \
        "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/wan22/gguf/WAN2.2-I2V-Full-AutoPrompt-MMAudio-GGUF.json" \
        "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/wan22/gguf/WAN2.2-T2V-I2V-Full-AutoPrompt-MMAudio-GGUF.json"; do \
        rel="${url#*workflows/}"; \
        outdir=$(dirname "$rel"); \
        mkdir -p "$outdir"; \
        name=$(basename "$url"); \
        echo "Downloading $rel..."; \
        for attempt in 1 2 3; do \
            curl -fsSL --retry 3 --connect-timeout 30 "$url" -o "$rel" && break; \
            echo "⚠️  $rel download failed (attempt $attempt), retrying..."; \
            sleep 5; \
        done; \
        [ -s "$rel" ] || { echo "❌ Failed to download $rel"; exit 1; }; \
    done

# ──────────────────────────────────────────────────────────────────────────────
# Enable Rust-based Hugging Face downloader (hf-transfer) for model downloads
# This is much faster than aria2/wget single-connection on HF-hosted files.
# ──────────────────────────────────────────────────────────────────────────────
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# ──────────────────────────────────────────────────────────────────────────────

# WAN models download script (~30GB, downloaded at boot in background)
# Waits for /workspace/runpod-slim/ComfyUI to exist, then downloads if missing.
# Robust: retries with backoff, resumes interrupted downloads, verifies size.
# ──────────────────────────────────────────────────────────────────────────────
RUN cat > /usr/local/bin/download-wan-models.sh << 'EOF'
#!/bin/bash
COMFY_BASE="/workspace/runpod-slim/ComfyUI/models"
LOG="/var/log/wan-models.log"
READY_MARKER="/workspace/runpod-slim/ComfyUI/main.py"   # created by start.sh copy

# Models: subdir|name|repo_id|repo_path|min_size_bytes (min_size = sanity check, ~98% of real size)
MODELS=(
    "diffusion_models|wan22RemixT2VI2V_i2vHighV30.safetensors|huchukato/pimp-my-wan|FP8/wan22RemixT2VI2V_i2vHighV30.safetensors|14000000000"
    "diffusion_models|wan22RemixT2VI2V_i2vLowV30.safetensors|huchukato/pimp-my-wan|FP8/wan22RemixT2VI2V_i2vLowV30.safetensors|14000000000"
    "text_encoders|nsfw_wan_umt5-xxl_fp8_scaled.safetensors|NSFW-API/NSFW-Wan-UMT5-XXL|nsfw_wan_umt5-xxl_fp8_scaled.safetensors|4800000000"
)

log() { echo "$(date): $*" | tee -a "$LOG"; }

log "📥 === WAN models download started (PID $$) — ${#MODELS[@]} models ==="

# ── Phase 1: wait for /workspace to be mounted and start.sh to finish copying ──
log "⏳ Waiting for /workspace mount and ComfyUI ready marker..."
for i in $(seq 1 120); do
    [ -f "$READY_MARKER" ] && break
    sleep 5
done

if [ ! -f "$READY_MARKER" ]; then
    log "❌ ERROR: ComfyUI ready marker not found after 600s, aborting"
    exit 1
fi

log "✅ ComfyUI ready, models base: $COMFY_BASE"

# ── Phase 2: download each model with retry + resume + size check ──
download_model() {
    local subdir="$1" name="$2" repo_id="$3" repo_path="$4" min_size="$5"
    local models_dir="$COMFY_BASE/$subdir"
    local dest="$models_dir/$name"
    local max_retries=5

    # Use 'hf' command (newer huggingface_hub) or fall back to 'huggingface-cli'
    local hf_cmd="hf"
    command -v hf >/dev/null 2>&1 || hf_cmd="huggingface-cli"

    for attempt in $(seq 1 $max_retries); do
        # Check if already complete (size >= min_size)
        if [ -f "$dest" ]; then
            local size
            size=$(stat -c%s "$dest" 2>/dev/null || stat -f%z "$dest" 2>/dev/null || echo 0)
            if [ "$size" -ge "$min_size" ]; then
                log "✅ $name already present ($size bytes >= $min_size), skipping"
                return 0
            else
                log "⚠️  $name incomplete ($size bytes < $min_size), resuming (attempt $attempt/$max_retries)"
            fi
        else
            log "📥 Downloading $name (attempt $attempt/$max_retries)..."
        fi

        # Download to a temp dir to avoid path nesting issues.
        local tmp_dir="$models_dir/.tmp_${name//\//_}"
        rm -rf "$tmp_dir"
        mkdir -p "$tmp_dir" "$models_dir"
        export HF_HUB_ENABLE_HF_TRANSFER=1
        export HF_XET_HIGH_PERFORMANCE=1
        # hf: resume is automatic; huggingface-cli: needs --resume-download
        local resume_flag=""
        [ "$hf_cmd" = "huggingface-cli" ] && resume_flag="--resume-download"
        if $hf_cmd download "$repo_id" "$repo_path" \
                --local-dir "$tmp_dir" \
                $resume_flag 2>&1 | tee -a "$LOG"; then
            local downloaded_path="$tmp_dir/$repo_path"
            if [ -f "$downloaded_path" ] || [ -L "$downloaded_path" ]; then
                if [ -L "$downloaded_path" ]; then
                    ln -sf "$(readlink -f "$downloaded_path")" "$dest"
                else
                    mv -f "$downloaded_path" "$dest"
                fi
                rm -rf "$tmp_dir"
                local size
                size=$(stat -L -c%s "$dest" 2>/dev/null || stat -L -f%z "$dest" 2>/dev/null || echo 0)
                if [ "$size" -ge "$min_size" ]; then
                    log "✅ $name downloaded successfully ($size bytes)"
                    return 0
                else
                    log "⚠️  $name downloaded but size $size < $min_size, will retry"
                fi
            else
                log "⚠️  $name not found at $downloaded_path after download, will retry"
                rm -rf "$tmp_dir"
            fi
        else
            log "⚠️  $hf_cmd failed for $name (attempt $attempt), retrying in $((attempt*10))s..."
            rm -rf "$tmp_dir"
        fi

        # Backoff before retry (skip on last attempt)
        [ "$attempt" -lt "$max_retries" ] && sleep $((attempt * 10))
    done

    log "❌ FAILED: $name could not be downloaded after $max_retries attempts"
    return 1
}

failures=0
MODEL_IDX=0
TOTAL_MODELS=${#MODELS[@]}
for entry in "${MODELS[@]}"; do
    MODEL_IDX=$((MODEL_IDX + 1))
    IFS='|' read -r subdir name repo_id repo_path min_size <<< "$entry"
    log "━━━ [$MODEL_IDX/$TOTAL_MODELS] ━━━"
    download_model "$subdir" "$name" "$repo_id" "$repo_path" "$min_size" || failures=$((failures + 1))
done

log "📦 === WAN models download finished ($failures failures) ==="
log "✅ All models ready — ComfyUI can now use WAN workflows"
EOF
RUN chmod +x /usr/local/bin/download-wan-models.sh

# ──────────────────────────────────────────────────────────────────────────────
# Boot updates script: ComfyUI core git pull + workflow refresh from GitHub.
# Runs fully in background (launched via setsid in custom-entrypoint.sh) so
# network hiccups NEVER delay/block ComfyUI startup. Bounded timeouts/retries
# everywhere as defense in depth.
# ──────────────────────────────────────────────────────────────────────────────
RUN cat > /usr/local/bin/boot-updates.sh << 'EOF'
#!/bin/bash
COMFY_LOG="/var/log/comfyui-update.log"
WF_LOG="/var/log/workflow-update.log"
COMFY_TAG="${COMFYUI_VERSION:-v0.34.2}"

clog() { echo "$(date): $*" | tee -a "$COMFY_LOG"; }
wlog() { echo "$(date): $*" | tee -a "$WF_LOG"; }

# ──────────────────────────────────────────────────────────────────────────────
# Force ComfyUI core to the required tag (baked + active install)
# Skips if already on the tag, otherwise resets/cleans and checks out the tag.
# Re-installs requirements when the version changes.
# ──────────────────────────────────────────────────────────────────────────────
force_comfyui_version() {
    local repo_dir="$1"
    local label="$2"
    if [ ! -d "$repo_dir/.git" ]; then
        clog "⚠️  $label no .git, skipping"
        return 0
    fi

    local current_tag
    current_tag=$(git -C "$repo_dir" describe --tags --exact-match HEAD 2>/dev/null || echo "")
    if [ "$current_tag" = "$COMFY_TAG" ]; then
        clog "✅ $label already on $COMFY_TAG"
        return 0
    fi

    clog "🔧 Ensuring $label is on $COMFY_TAG (current: ${current_tag:-unknown})..."
    git -C "$repo_dir" reset --hard 2>>"$COMFY_LOG" || true
    git -C "$repo_dir" clean -fd 2>>"$COMFY_LOG" || true

    if timeout 60 git -C "$repo_dir" fetch --tags origin 2>>"$COMFY_LOG"; then
        local current_hash target_hash
        current_hash=$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null || echo "unknown")
        if timeout 30 git -C "$repo_dir" -c advice.detachedHead=false checkout -f "$COMFY_TAG" 2>>"$COMFY_LOG"; then
            target_hash=$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null || echo "unknown")
            clog "✅ $label forced to $COMFY_TAG ($current_hash -> $target_hash)"
            if [ -f "$repo_dir/requirements.txt" ]; then
                clog "🔄 Re-installing $label requirements..."
                pip install --no-cache-dir -r "$repo_dir/requirements.txt" 2>>"$COMFY_LOG" | tail -n 10 || true
            fi
        else
            clog "❌ $label checkout $COMFY_TAG failed"
        fi
    else
        clog "⚠️  $label fetch tags failed/timed out (offline?), leaving at current version"
    fi
}

# ──────────────────────────────────────────────────────────────────────────────
# Update all custom nodes in a directory (git pull --ff-only, then hard reset)
# Re-installs requirements when a node is updated.
# ──────────────────────────────────────────────────────────────────────────────
update_custom_nodes() {
    local nodes_dir="$1"
    [ ! -d "$nodes_dir" ] && return 0
    clog "🔄 Updating custom nodes in $nodes_dir..."
    for node_dir in "$nodes_dir"/*; do
        [ ! -d "$node_dir/.git" ] && continue
        local name branch remote_url
        name=$(basename "$node_dir")
        branch=$(git -C "$node_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
        remote_url=$(git -C "$node_dir" config --get remote.origin.url 2>/dev/null || echo "")
        if [ -z "$remote_url" ]; then
            clog "⚠️  $name has no remote.origin.url, skipping"
            continue
        fi
        clog "⏳ Updating $name (branch $branch)..."
        # Always fetch + hard reset to ensure baked nodes are updated too.
        # Baked nodes from the base image often have divergent/dirty state
        # that makes git pull --ff-only fail silently.
        if timeout 60 git -C "$node_dir" fetch origin "$branch" 2>>"$COMFY_LOG" && \
           timeout 30 git -C "$node_dir" reset --hard "origin/$branch" 2>>"$COMFY_LOG" && \
           timeout 30 git -C "$node_dir" clean -fd 2>>"$COMFY_LOG"; then
            clog "✅ $name updated to origin/$branch"
        else
            clog "⚠️  $name update failed, leaving as-is"
        fi
        # NOTE: requirements.txt is NOT installed at boot time.
        # pip install at boot can break torch/transformers by upgrading
        # packages that are pinned to specific CUDA versions in the image.
        # Requirements are installed only at Docker build time.
    done
}

# ──────────────────────────────────────────────────────────────────────────────
# Check & update workflows from GitHub (small JSON files, no need to rebuild image)
# - Baked baseline: /opt/comfyui-baked/user/default/workflows/ (read-only reference)
# - If user hasn't modified a workflow (matches baked) → update from GitHub
# - If user modified it (differs from baked) → skip, preserve user changes
# --tries=2 caps each wget's worst case instead of the wget default of 20 retries.
# ──────────────────────────────────────────────────────────────────────────────
WORKFLOWS=(
    "utils/2in1-LoRaStack-Merge.json"
    "utils/RIFE-TensorRT-60FPS.json"
    "pony/PimpMyPony-TagComplete-Wildcards.json"
    "pony/PimpMyPony-TagComplete-Wildcards-HiresFix.json"
    "pony/PimpMyPony-TagComplete-FaceDet.json"
    "wan22/fp8/WAN2.2-I2V-AutoPrompt-Story.json"
    "wan22/fp8/WAN2.2-T2V-I2V-AutoPrompt-Story.json"
    "wan22/fp8/WAN2.2-I2V-SVI-AutoPrompt-Story.json"
    "wan22/fp8/WAN2.2-I2V-AutoPrompt.json"
    "wan22/gguf/WAN2.2-I2V-AutoPrompt-GGUF.json"
    "wan22/fp8/WAN2.2-T2V-AutoPrompt.json"
    "wan22/gguf/WAN2.2-T2V-AutoPrompt-GGUF.json"
    "wan22/fp8/WAN2.2-I2V-SVI-AutoPrompt.json"
    "wan22/gguf/WAN2.2-I2V-SVI-AutoPrompt-GGUF.json"
    "wan22/fp8/WAN2.2-I2V-Full-AutoPrompt-MMAudio.json"
    "wan22/gguf/WAN2.2-I2V-Full-AutoPrompt-MMAudio-GGUF.json"
    "wan22/gguf/WAN2.2-T2V-I2V-Full-AutoPrompt-MMAudio-GGUF.json"
)
WF_BASE_URL="https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows"
WF_BAKED="/opt/comfyui-baked/user/default/workflows"
WF_ACTIVE="/workspace/runpod-slim/ComfyUI/user/default/workflows"
WF_READY="/workspace/runpod-slim/ComfyUI/main.py"

download_workflows() {
    local target_dir="$1"
    local label="$2"
    mkdir -p "$target_dir"

    wlog "🔄 Downloading workflows for $label..."
    local downloaded=0 failed=0

    for wf in "${WORKFLOWS[@]}"; do
        local subdir
        subdir=$(dirname "$wf")
        mkdir -p "$target_dir/$subdir"
        if curl -fsSL --retry 3 --connect-timeout 30 "$WF_BASE_URL/$wf" -o "$target_dir/$wf"; then
            wlog "  ✅ $wf"
            downloaded=$((downloaded + 1))
        else
            wlog "  ❌ $wf failed"
            failed=$((failed + 1))
        fi
    done

    wlog "📋 $label: $downloaded downloaded, $failed failed"
}

wlog "🚀 === Boot updates started (PID $$) ==="

# Update baked template baseline first
download_workflows "$WF_BAKED" "baked"

# Wait for start.sh to finish copying /opt/comfyui-baked -> /workspace/runpod-slim/ComfyUI
# before downloading active workflows; otherwise start.sh may overwrite with old baked copies.
wlog "⏳ Waiting for active ComfyUI install (/workspace) to be ready..."
for i in $(seq 1 120); do
    [ -f "$WF_READY" ] && break
    sleep 5
done

if [ ! -f "$WF_READY" ]; then
    wlog "❌ ERROR: /workspace ComfyUI not ready after 600s, aborting active workflow download"
    exit 1
fi
wlog "✅ /workspace ComfyUI ready"

# Now safe to download active install workflows
download_workflows "$WF_ACTIVE" "active"

# Force baked ComfyUI core to selected version
force_comfyui_version /opt/comfyui-baked "ComfyUI (baked template)"

# Force active install on /workspace if it already exists (affects restarts)
if [ -d /workspace/runpod-slim/ComfyUI/.git ]; then
    force_comfyui_version /workspace/runpod-slim/ComfyUI "ComfyUI (active install)"
    update_custom_nodes /workspace/runpod-slim/ComfyUI/custom_nodes
fi

clog "🏁 === Boot updates finished ==="
EOF
RUN chmod +x /usr/local/bin/boot-updates.sh

# ──────────────────────────────────────────────────────────────────────────────
# Custom entrypoint: pre-populate comfyui_args.txt, launch boot updates + WAN
# models download fully in background, then exec /start.sh IMMEDIATELY.
# Network calls never block ComfyUI startup.
# ──────────────────────────────────────────────────────────────────────────────
RUN cat > /usr/local/bin/custom-entrypoint.sh << 'EOF'
#!/bin/bash

# Overwrite comfyui_args.txt with WAN2.2 optimized args
# The RunPod base image pre-populates this file with its own defaults.
ARGS_FILE="/workspace/runpod-slim/comfyui_args.txt"
mkdir -p /workspace/runpod-slim
cat > "$ARGS_FILE" << 'INNER'
# Custom ComfyUI arguments (one per line, # = comment)
--disable-auto-launch --fast fp16_accumulation --use-sage-attention --cuda-malloc --async-offload
INNER
echo "Overwrote comfyui_args.txt with WAN2.2 optimized args"

# Launch boot updates (ComfyUI git pull + workflow refresh) in a detached
# session. setsid creates a new session, so the process is fully independent
# of PID 1 and survives `exec /start.sh` below. Output is NOT redirected to
# /dev/null: each script tees its own log to file AND inherits this
# entrypoint's stdout, so progress shows up in `docker logs` / RunPod logs.
setsid /usr/local/bin/boot-updates.sh </dev/null &

# Launch WAN models download in a detached session (survives exec /start.sh)
setsid /usr/local/bin/download-wan-models.sh </dev/null &

# Execute original start.sh from template base — runs immediately, never
# waits on the network calls above.
exec /start.sh
EOF
RUN chmod +x /usr/local/bin/custom-entrypoint.sh

# Override entrypoint (inherits EXPOSE, WORKDIR from template base)
ENTRYPOINT ["/usr/local/bin/custom-entrypoint.sh"]
