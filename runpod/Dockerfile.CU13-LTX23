# ComfyUI-Garage RunPod Worker (CUDA 13.0) — LTX 2.3 edition
# Based on comfyui-base:cu130 (our custom base with ComfyUI v0.34.2, TensorRT,
# Manager with use_uv=False, dynamic venv naming, no uv).
# Adds: QwenVL-Mod + LTXVideo support nodes, all heavy LTX-2.3 models
#       downloaded at boot in background (~40GB total, uncensored 10Eros setup).

FROM huchukato/comfyui-base:cu130

# ──────────────────────────────────────────────────────────────────────────────
# Custom nodes — ALL repos cloned once (cached by Docker)
# LTX 2.3 core support is built into ComfyUI 0.30.0+; LTXVideo node adds workflow nodes.
# Use --no-cache to force re-clone when nodes need updating.
# ──────────────────────────────────────────────────────────────────────────────
ARG CACHEBUST=1

ENV GIT_TERMINAL_PROMPT=0
RUN dl_gh() { \
    local user="$1" repo="$2" branch="${3:-main}" dir="$4"; \
    echo "Downloading $user/$repo ($branch) -> $dir"; \
    curl -fsSL "https://codeload.github.com/$user/$repo/tar.gz/refs/heads/$branch" -o "/tmp/$dir.tgz" && \
    mkdir -p "/opt/comfyui-baked/custom_nodes/$dir" && \
    tar -xzf "/tmp/$dir.tgz" -C "/opt/comfyui-baked/custom_nodes/$dir" --strip-components=1 && \
    rm -f "/tmp/$dir.tgz"; \
  } && \
    cd /opt/comfyui-baked/custom_nodes && \
    dl_gh Lightricks ComfyUI-LTXVideo master ComfyUI-LTXVideo && \
    dl_gh Koishi-Star Euler-Smea-Dyn-Sampler main Euler-Smea-Dyn-Sampler && \
    dl_gh ltdrdata was-node-suite-comfyui main was-node-suite-comfyui && \
    dl_gh Kosinkadink ComfyUI-VideoHelperSuite main ComfyUI-VideoHelperSuite && \
    dl_gh rgthree rgthree-comfy main rgthree-comfy && \
    dl_gh yolain ComfyUI-Easy-Use main ComfyUI-Easy-Use && \
    dl_gh ashtar1984 comfyui-find-perfect-resolution main comfyui-find-perfect-resolution && \
    dl_gh domprosys ComfyUI-LTXVideo-Extra master ComfyUI-LTXVideo-Extra && \
    dl_gh huchukato ComfyUI-QwenVL-Mod main ComfyUI-QwenVL-Mod && \
    dl_gh huchukato ComfyUI-RIFE-TensorRT-Auto master ComfyUI-RIFE-TensorRT-Auto && \
    dl_gh huchukato ComfyUI-Upscaler-TensorRT-Auto master ComfyUI-Upscaler-TensorRT-Auto && \
    dl_gh huchukato ComfyUI-HuggingFace main ComfyUI-HuggingFace && \
    dl_gh huchukato comfy-tagcomplete main comfy-tagcomplete && \
    dl_gh ltdrdata ComfyUI-Impact-Pack main ComfyUI-Impact-Pack && \
    dl_gh ltdrdata ComfyUI-Impack-Subpack main ComfyUI-Impack-Subpack

# ──────────────────────────────────────────────────────────────────────────────
# Install requirements (single layer, cached)
# Also pin kornia<0.8.3 — ComfyUI-LTXVideo breaks on newer kornia (pad import)
# ──────────────────────────────────────────────────────────────────────────────
RUN bash -c 'cd /opt/comfyui-baked/custom_nodes && for node_dir in */; do \
        if [ -f "$node_dir/requirements.txt" ]; then \
            echo "Installing requirements for $node_dir..." && \
            pip install --no-cache-dir -r "$node_dir/requirements.txt" || echo "Failed to install requirements for $node_dir"; \
        fi; \
    done' && \
    pip install --no-cache-dir "kornia==0.8.2" && \
    pip cache purge

# ──────────────────────────────────────────────────────────────────────────────
# Model directories (models downloaded at boot, not baked due to ~40GB total)
# ──────────────────────────────────────────────────────────────────────────────
RUN mkdir -p /opt/comfyui-baked/models/checkpoints && \
    mkdir -p /opt/comfyui-baked/models/text_encoders && \
    mkdir -p /opt/comfyui-baked/models/loras && \
    mkdir -p /opt/comfyui-baked/models/upscale_models && \
    mkdir -p /opt/comfyui-baked/models/vae && \
    mkdir -p /opt/comfyui-baked/models/ultralytics/bbox && \
    mkdir -p /opt/comfyui-baked/models/sams

# ──────────────────────────────────────────────────────────────────────────────
# Pre-baked YOLO + SAM models for Impact Pack FaceDetailer
# ──────────────────────────────────────────────────────────────────────────────
RUN wget -q --tries=5 --timeout=60 --retry-connrefused \
        "https://huggingface.co/huchukato/favs/resolve/main/adetailer/face_yolov8m.pt" \
        -O /opt/comfyui-baked/models/ultralytics/bbox/face_yolov8m.pt && \
    wget -q --tries=5 --timeout=60 --retry-connrefused \
        "https://huggingface.co/bingbangboom/sam_vit_b/resolve/main/sam_vit_b_01ec64.pth" \
        -O /opt/comfyui-baked/models/sams/sam_vit_b_01ec64.pth

# ──────────────────────────────────────────────────────────────────────────────
# Optional Hugging Face token (runtime env var) for gated/high-rate-limit
# downloads. Set HF_TOKEN in the RunPod template environment variables.
# ──────────────────────────────────────────────────────────────────────────────
ENV HF_TOKEN=""

# ──────────────────────────────────────────────────────────────────────────────
# Enable Rust-based Hugging Face downloader (hf-transfer) for model downloads
# This is much faster than aria2/wget single-connection on HF-hosted files.
# ──────────────────────────────────────────────────────────────────────────────
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# ──────────────────────────────────────────────────────────────────────────────
# LTX 2.3 workflow download script (small JSON, downloaded at boot)
# Always fetches latest from GitHub into the active /workspace install.
# Overwrites existing files at every boot.
# ──────────────────────────────────────────────────────────────────────────────
RUN cat > /usr/local/bin/download-ltx-workflows.sh << 'EOF'
#!/bin/bash
LOG="/var/log/ltx-workflows.log"
BASE_DIR="/workspace/runpod-slim/ComfyUI/user/default/workflows"
LTX_WF_URL="https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/ltx/23"
PONY_WF_URL="https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/pony"
READY_MARKER="/workspace/runpod-slim/ComfyUI/main.py"
LTX_WORKFLOWS=(
    "LTX23-I2VA-T2VA-Qwen3.5.json"
    "LTX23-FL2VA-Qwen3.5.json"
)
PONY_WORKFLOWS=(
    "PimpMyPony-TagComplete-Wildcards.json"
    "PimpMyPony-TagComplete-Wildcards-HiresFix.json"
    "PimpMyPony-TagComplete-FaceDet.json"
)
UTIL_WORKFLOWS=(
    "2in1-LoRaStack-Merge.json"
    "RIFE-TensorRT-60FPS.json"
)

log() { echo "$(date): $*" | tee -a "$LOG"; }

download_list() {
    local base_url="$1"
    local subdir="$2"
    shift 2
    local wfs=("$@")
    mkdir -p "$BASE_DIR/$subdir"
    for wf in "${wfs[@]}"; do
        dest="$BASE_DIR/$subdir/$wf"
        if wget -q --tries=3 --timeout=30 "$base_url/$wf" -O "$dest"; then
            log "✅ $subdir/$wf downloaded"
        else
            log "❌ $subdir/$wf download failed"
        fi
    done
}

log "⏳ Waiting for /workspace ComfyUI..."
for i in $(seq 1 120); do
    [ -f "$READY_MARKER" ] && break
    sleep 5
done

if [ ! -f "$READY_MARKER" ]; then
    log "❌ ERROR: ComfyUI not ready after 600s, aborting workflow download"
    exit 1
fi

mkdir -p "$BASE_DIR"
log "🔄 Downloading latest LTX 2.3 workflows..."
download_list "$LTX_WF_URL" "ltx/23" "${LTX_WORKFLOWS[@]}"
log "🔄 Downloading shared Pony/LoRA-stack workflow..."
download_list "$PONY_WF_URL" "pony" "${PONY_WORKFLOWS[@]}"
log "🔄 Downloading utility workflows..."
download_list "https://github.com/huchukato/ComfyUI-Garage/raw/master/workflows/utils" "utils" "${UTIL_WORKFLOWS[@]}"

log "🏁 Workflow downloads done"
EOF
RUN chmod +x /usr/local/bin/download-ltx-workflows.sh

# ──────────────────────────────────────────────────────────────────────────────
# NO models baked-in here — all LTX-2.3 models are huge:
#   ~40GB total. Instead, a boot script downloads them to /workspace on first run.
#   Only uncensored/required models are downloaded:
#     - 10Eros v1.5 FP8 (checkpoint, ~30GB) — uncensored I2V merge of Sulphur 2
#     - Gemma 3 12B IT FP4 (text encoder, ~9.4GB)
#     - Gemma 3 12B abliterated LoRA (~628MB) — uncensors text encoder (bypass/strength 0 in workflow, available if needed)
#     - LTX 2.3 DMD hybrid v2 LoRA (~662MB) — required by 10Eros v1.5
#     - LTX 2.3 spatial upscaler (~996MB) — doubles resolution
#     - LTX 2.3 temporal upscaler (~262MB) — doubles frame count
# ──────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────────

# LTX 2.3 model download script (~40GB, downloaded at boot in background)
# Waits for /workspace/runpod-slim/ComfyUI to exist, then downloads if missing.
# Robust: retries with backoff, resumes interrupted downloads, verifies size.
# ──────────────────────────────────────────────────────────────────────────────
RUN cat > /usr/local/bin/download-ltx-models.sh << 'EOF'
#!/bin/bash
BASE_DIR="/workspace/runpod-slim/ComfyUI/models"
LOG="/var/log/ltx-models.log"
READY_MARKER="/workspace/runpod-slim/ComfyUI/main.py"   # created by start.sh copy

# Ensure hf-transfer is available (Rust accelerator for HF downloads)
pip install --no-cache-dir -q "hf-transfer" "huggingface_hub" 2>/dev/null
export HF_HUB_ENABLE_HF_TRANSFER=1
export HF_XET_HIGH_PERFORMANCE=1

# Models: subdir|name|repo_id|repo_path|min_size_bytes (min_size = sanity check)
MODELS=(
    "checkpoints|10Eros_v1.5_fp8mixed_experimental_learned.safetensors|LokkenJP/10EROS_1.5_fp8_exp_learned|10Eros_v1.5_fp8mixed_experimental_learned.safetensors|28000000000"
    "text_encoders|gemma-3-12b-it-ablit-norms-biproj-fp8mixed.safetensors|TenStrip/LTX2.3-10Eros|text_encoders/gemma-3-12b-it-ablit-norms-biproj-fp8mixed.safetensors|12000000000"
    "loras|ltx23/LTX2.3_DMD_hybrid_v2.safetensors|TenStrip/LTX2.3_DMD_Lora|LTX2.3_DMD_hybrid_v2.safetensors|600000000"
    # ── Gemma 3 12B abliterated LoRA (referenziata nel workflow I2VA, nodo in bypass/strength 0) ──
    "loras|gemma-3-12b-it-abliterated_lora_rank64_bf16.safetensors|Comfy-Org/ltx-2|split_files/loras/gemma-3-12b-it-abliterated_lora_rank64_bf16.safetensors|600000000"
    "latent_upscale_models|ltx-2.3-spatial-upscaler-x2-1.1.safetensors|Lightricks/LTX-2.3|ltx-2.3-spatial-upscaler-x2-1.1.safetensors|900000000"
    "latent_upscale_models|ltx-2.3-temporal-upscaler-x2-1.0.safetensors|Lightricks/LTX-2.3|ltx-2.3-temporal-upscaler-x2-1.0.safetensors|250000000"
    # Pruna optimized VAE (faster decode than stock LTX VAE)
    "vae|pruna_ltx2.3_vae_comfy_bf16.safetensors|Kijai/LTX2.3_comfy|vae/pruna_ltx2.3_vae_comfy_bf16.safetensors|500000000"
)

log() { echo "$(date): $*" | tee -a "$LOG"; }

log "📥 === LTX 2.3 model download started (PID $$) — ${#MODELS[@]} models ==="
log "⏳ Waiting for /workspace mount and ComfyUI ready marker..."
for i in $(seq 1 120); do
    [ -f "$READY_MARKER" ] && break
    sleep 5
done

if [ ! -f "$READY_MARKER" ]; then
    log "❌ ERROR: ComfyUI ready marker not found after 600s, aborting"
    exit 1
fi

log "✅ ComfyUI ready, base dir: $BASE_DIR"
mkdir -p "$BASE_DIR"/{checkpoints,text_encoders,loras/ltx23,latent_upscale_models,vae}

download_model() {
    local subdir="$1" name="$2" repo_id="$3" repo_path="$4" min_size="$5"
    local dest="$BASE_DIR/$subdir/$name"
    local max_retries=5

    # Use 'hf' command (newer huggingface_hub) or fall back to 'huggingface-cli'
    local hf_cmd="hf"
    command -v hf >/dev/null 2>&1 || hf_cmd="huggingface-cli"

    for attempt in $(seq 1 $max_retries); do
        if [ -f "$dest" ] || [ -L "$dest" ]; then
            local size
            size=$(stat -L -c%s "$dest" 2>/dev/null || stat -L -f%z "$dest" 2>/dev/null || echo 0)
            if [ "$size" -ge "$min_size" ]; then
                log "✅ $name already present ($size bytes >= $min_size), skipping"
                return 0
            else
                log "⚠️  $name incomplete ($size bytes < $min_size), retrying (attempt $attempt/$max_retries)"
            fi
        else
            log "📥 Downloading $name (attempt $attempt/$max_retries)..."
        fi

        # Download to a temp dir to avoid path nesting issues.
        local tmp_dir="$BASE_DIR/.tmp_download_${name//\//_}"
        rm -rf "$tmp_dir"
        mkdir -p "$tmp_dir" "$(dirname "$dest")"
        export HF_HUB_ENABLE_HF_TRANSFER=1
        export HF_XET_HIGH_PERFORMANCE=1
        # hf: resume is automatic; huggingface-cli: needs --resume-download
        local resume_flag=""
        [ "$hf_cmd" = "huggingface-cli" ] && resume_flag="--resume-download"
        # Timeout: 15 min per file, prevents infinite stalls
        if timeout 900 $hf_cmd download "$repo_id" "$repo_path" \
                --local-dir "$tmp_dir" \
                $resume_flag 2>&1 | tee -a "$LOG"; then
            # Find the downloaded file (hf preserves repo_path structure)
            local downloaded_path="$tmp_dir/$repo_path"
            if [ -f "$downloaded_path" ] || [ -L "$downloaded_path" ]; then
                # Move/symlink to final destination
                if [ -L "$downloaded_path" ]; then
                    ln -sf "$(readlink -f "$downloaded_path")" "$dest"
                else
                    mv -f "$downloaded_path" "$dest"
                fi
                rm -rf "$tmp_dir"
                local size
                size=$(stat -L -c%s "$dest" 2>/dev/null || stat -L -f%z "$dest" 2>/dev/null || echo 0)
                if [ "$size" -ge "$min_size" ]; then
                    log "✅ $name downloaded successfully ($size bytes)"
                    return 0
                else
                    log "⚠️  $name downloaded but size $size < $min_size, will retry"
                fi
            else
                log "⚠️  $name not found at $downloaded_path after download, will retry"
                rm -rf "$tmp_dir"
            fi
        else
            log "⚠️  $hf_cmd failed for $name (attempt $attempt), retrying in $((attempt*10))s..."
            rm -rf "$tmp_dir"
        fi

        [ "$attempt" -lt "$max_retries" ] && sleep $((attempt * 10))
    done

    log "❌ FAILED: $name could not be downloaded after $max_retries attempts"
    return 1
}

failures=0
MODEL_IDX=0
TOTAL_MODELS=${#MODELS[@]}
for entry in "${MODELS[@]}"; do
    MODEL_IDX=$((MODEL_IDX + 1))
    IFS='|' read -r subdir name repo_id repo_path min_size <<< "$entry"
    log "━━━ [$MODEL_IDX/$TOTAL_MODELS] ━━━"
    download_model "$subdir" "$name" "$repo_id" "$repo_path" "$min_size" || failures=$((failures + 1))
done

log "📦 === LTX 2.3 model download finished ($failures failures) ==="
log "✅ All models ready — ComfyUI can now use LTX 2.3 workflows"
EOF
RUN chmod +x /usr/local/bin/download-ltx-models.sh

# ──────────────────────────────────────────────────────────────────────────────
# Custom entrypoint: force baked ComfyUI to selected version, pre-populate args,
# launch LTX model download in background, then exec /start.sh
# ──────────────────────────────────────────────────────────────────────────────
RUN cat > /usr/local/bin/custom-entrypoint.sh << 'EOF'
#!/bin/bash
COMFY_LOG="/var/log/comfyui-update.log"

update_custom_nodes() {
    local nodes_dir="$1"
    [ ! -d "$nodes_dir" ] && return 0
    echo "$(date): 🔄 Updating custom nodes in $nodes_dir..." | tee -a "$COMFY_LOG"
    for node_dir in "$nodes_dir"/*; do
        [ ! -d "$node_dir/.git" ] && continue
        local name branch remote_url
        name=$(basename "$node_dir")
        branch=$(git -C "$node_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
        remote_url=$(git -C "$node_dir" config --get remote.origin.url 2>/dev/null || echo "")
        if [ -z "$remote_url" ]; then
            echo "$(date): ⚠️  $name has no remote.origin.url, skipping" | tee -a "$COMFY_LOG"
            continue
        fi
        echo "$(date): ⏳ Updating $name (branch $branch)..." | tee -a "$COMFY_LOG"
        if timeout 60 git -C "$node_dir" fetch origin "$branch" 2>>"$COMFY_LOG" && \
           timeout 30 git -C "$node_dir" reset --hard "origin/$branch" 2>>"$COMFY_LOG" && \
           timeout 30 git -C "$node_dir" clean -fd 2>>"$COMFY_LOG"; then
            echo "$(date): ✅ $name updated to origin/$branch" | tee -a "$COMFY_LOG"
        else
            echo "$(date): ⚠️  $name update failed, leaving as-is" | tee -a "$COMFY_LOG"
        fi
    done
}

# Update custom nodes in the active install if it already exists
if [ -d /workspace/runpod-slim/ComfyUI/.git ]; then
    update_custom_nodes /workspace/runpod-slim/ComfyUI/custom_nodes
fi

# Overwrite comfyui_args.txt with LTX 2.3 / QwenVL-Mod optimized args
ARGS_FILE="/workspace/runpod-slim/comfyui_args.txt"
mkdir -p /workspace/runpod-slim
cat > "$ARGS_FILE" << 'INNER'
# Custom ComfyUI arguments (one per line, # = comment)
--disable-auto-launch --fast fp16_accumulation --use-sage-attention --cuda-malloc --async-offload
INNER
echo "Overwrote comfyui_args.txt with LTX 2.3 / QwenVL-Mod optimized args"

# Launch LTX 2.3 workflow download in background
setsid /usr/local/bin/download-ltx-workflows.sh </dev/null &

# Launch LTX 2.3 model download in a detached session
setsid /usr/local/bin/download-ltx-models.sh </dev/null &

exec /start.sh
EOF
RUN chmod +x /usr/local/bin/custom-entrypoint.sh

# Override entrypoint
ENTRYPOINT ["/usr/local/bin/custom-entrypoint.sh"]
